# =====================================================
# Memory System Configuration Template
# =====================================================
#
# SECURITY NOTICE:
# - Copy this file to .env and fill in your actual API keys
# - Never commit .env file to version control
# - Keep your API keys secure and private
#
# SETUP INSTRUCTIONS:
# 1. cp env.template .env
# 2. Edit .env with your actual values
# 3. The system will automatically load these values
# =====================================================


# ===================
# LLM Configuration
# ===================

LLM_PROVIDER=openai
# For evaluation, use openai/gpt-4.1-mini to ensure reproducibility
# For demo, use x-ai/grok-4-fast for a balance of speed/cost/quality
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=your_bailian_api_key
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=32768
# OpenRouter/other provider settings, default is "default"
# When using Qwen3 via OpenRouter, consider setting to "cerebras"
# LLM_OPENROUTER_PROVIDER=cerebras

# ===================
# Recall Judge LLM Configuration (src/utils/recall_evaluator.py)
# ===================
# 专用于 coverage/answerability 判定的 LLM，独立于上方主 pipeline 的 LLM_*。
# 未设置时回退到对应的 LLM_* 字段。
# 判定任务要求确定性采样，temperature 建议 0.0 以保证可复现。
RECALL_JUDGE_MODEL=deepseek-v4-pro
RECALL_JUDGE_BASE_URL=https://api.deepseek.com
RECALL_JUDGE_API_KEY=your_api_key
RECALL_JUDGE_TEMPERATURE=0.0
RECALL_JUDGE_MAX_TOKENS=4096

# ===================
# Vectorize (Embedding) Service Configuration
# ===================

# ---- Primary Vectorize Provider ----
# Provider type: vllm (self-deployed), siliconflow (commercial API)
VECTORIZE_PROVIDER=siliconflow

# API key for primary provider (use "EMPTY" if not required for vllm service)
VECTORIZE_API_KEY=your_siliconflow_api_key

# Base URL for primary provider
# vLLM service example: http://localhost:8000/v1
# SiliconFlow example: https://api.siliconflow.cn/v1
VECTORIZE_BASE_URL=https://api.siliconflow.cn/v1

# Model name (shared by both primary and fallback providers)
VECTORIZE_MODEL=Qwen/Qwen3-Embedding-4B

# ---- Fallback Vectorize Provider (Optional) ----
# Fallback provider type: vllm, siliconflow, or none (to disable fallback)
# Note: Fallback will be disabled if provider is "none", base_url is empty,
#       or api_key is empty (for commercial API providers)
VECTORIZE_FALLBACK_PROVIDER=siliconflow

# API key for fallback provider (required for siliconflow, optional for vllm)
VECTORIZE_FALLBACK_API_KEY=your_siliconflow_api_key

# Base URL for fallback provider (required if fallback is enabled)
VECTORIZE_FALLBACK_BASE_URL=https://api.siliconflow.cn/v1

# ===== Common Settings =====
VECTORIZE_TIMEOUT=60
VECTORIZE_MAX_RETRIES=3
VECTORIZE_BATCH_SIZE=10
VECTORIZE_MAX_CONCURRENT=3
VECTORIZE_ENCODING_FORMAT=float

# Output embedding dimensions. Qwen3-Embedding-4B is MRL-trained, so the size is
# reduced SERVER-SIDE via the `dimensions` param (proper Matryoshka reduction,
# NOT naive truncation). SiliconFlow supports [64,128,256,512,768,1024,1536,
# 2048,2560]; native is 2560. Set to 0 to use the model's full native dimension.
# NOTE: changing this requires rebuilding the vector index.
VECTORIZE_DIMENSIONS=1024


# ===================
# Rerank Service Configuration
# ===================

# ---- Primary Rerank Provider ----
# Provider type: vllm (self-deployed), siliconflow (commercial API)
RERANK_PROVIDER=siliconflow

# API key for primary provider (use "EMPTY" if not required for vllm service)
RERANK_API_KEY=your_siliconflow_api_key

# Base URL for primary provider
# vLLM service example: http://localhost:12000/v1/rerank
# SiliconFlow example: https://api.siliconflow.cn/v1
RERANK_BASE_URL=https://api.siliconflow.cn/v1

# Model name (shared by both primary and fallback providers)
RERANK_MODEL=Qwen/Qwen3-Reranker-4B

# ---- Fallback Rerank Provider (Optional) ----
# Fallback provider type: vllm, siliconflow, or none (to disable fallback)
# Note: Fallback will be disabled if provider is "none", base_url is empty,
#       or api_key is empty (for commercial API providers)
RERANK_FALLBACK_PROVIDER=siliconflow

# API key for fallback provider (required for siliconflow, optional for vllm)
RERANK_FALLBACK_API_KEY=your_siliconflow_api_key

# Base URL for fallback provider (required if fallback is enabled)
RERANK_FALLBACK_BASE_URL=https://api.siliconflow.cn/v1

# ===== Common Settings =====
RERANK_TIMEOUT=30
RERANK_MAX_RETRIES=3
RERANK_BATCH_SIZE=10
RERANK_MAX_CONCURRENT=5


# ===================
# Environment & Logging
# ===================

LOG_LEVEL=INFO
ENV=dev
PYTHONASYNCIODEBUG=1
# MEMORY_LANGUAGE: 非-cli 入口（scripts/、直接调 API、memory_layer.prompts.get_prompt_by）的 fallback。
# evaluation/cli 跑 dataset 时，dataset yaml 的 memory_language 字段会强制覆盖（cli.py:148），
# 优先级: dataset yaml > .env > code default(en, language_utils.py:13)。
# 中文用户场景设 zh，英文 benchmark 场景设 en。
MEMORY_LANGUAGE=zh


# ===================
# MemScene Configuration (离线跨天事件演化场景层)
# ===================
#
# MemScene 是离线层（scripts/run_memscene.py），不在主检索 pipeline 里。
# 注：fast / period_summary / memcell_boundary_mode 等是主评测 pipeline 的开关，
#     走 evaluation/config/systems/lifemem.yaml 的 add 段，不在这里。
#
# 下面只放部署级总开关。**算法调参（余弦门 / 簇大小 / 触发间隔 / 重试）的默认值与
# 标定方法是 src/memory_layer/memscene/config.py 的单一真源**——为避免数值在两处漂移，
# 这里不复述具体默认值。这些参数同样可用同名 MEMSCENE_* env 覆盖（清单见 config.py 顶部
# docstring）：MEMSCENE_EMBED_RECALL_COSINE / _MERGE_COSINE / _MAX_RETRIES /
# MEMSCENE_POOL_HARVEST_INTERVAL_DAYS / _CLUSTER_COSINE / _MIN_CLUSTER_SIZE / _MAX_CLUSTERS。

# 语义预筛总开关（summary embedding 召回/合并）。1/true/yes/on 开，其它关。
# 不设时：真实 run 默认开，pytest 下默认关（保证单测 hermetic、不联网）。
# MEMSCENE_SEMANTIC_PREFILTER=1

# pool 周期性回收总开关，默认 true。
# MEMSCENE_POOL_HARVEST_ENABLED=true
